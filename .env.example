# Athena Options Engine — environment template
# Copy to .env on the Windows trading box. Never commit real secrets.

# --- Runtime ---
ATHENA_ENV=development
ATHENA_LOG_LEVEL=INFO
# paper uses ATHENA_IB_PAPER_ACCOUNT_ID. live uses ATHENA_IB_ACCOUNT_IDS.
# Both modes send real IB orders after Approve. The books stay separate.
ATHENA_TRADING_MODE=paper

# --- IB accounts (configure any ids; not hard-coded) ---
ATHENA_IB_PAPER_ACCOUNT_ID=
# Comma-separated live accounts. Each one keeps its own drafts, orders, and settings.
ATHENA_IB_ACCOUNT_IDS=
# Optional: fanit mapping only when sync is implemented later
ATHENA_FANIT_ACCOUNT_ID=
ATHENA_FANIT_ACCOUNT_NAME=
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4001
IB_CLIENT_ID=1
# Optional. Empty means /ops gateway restart does nothing.
ATHENA_GATEWAY_RESTART_CMD=

# --- Store ---
# Orchestrator reads DATABASE_URL on startup. Redis is unused in Phase 1.
DATABASE_URL=postgresql://athena:athena@127.0.0.1:55432/athena
REDIS_URL=redis://127.0.0.1:6379/0
# 300 seconds is the 5-minute cycle. ATHENA_LOOP_CYCLES=1 exits after one sleep.
ATHENA_LOOP_SECONDS=300

# --- Market data ---
ITICK_API_KEY=
ITICK_BASE_URL=

# --- Telegram (stub OK until filled; see docs/athena/05-human-control.md) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWLIST_USER_IDS=
TELEGRAM_MODE=polling
# Optional HTTP proxy. Leave empty when api.telegram.org is reachable directly.
TELEGRAM_HTTPS_PROXY=

# --- Feishu (stub until app created) ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWLIST_OPEN_IDS=

# --- control-web / ephemeral approve ---
# Local page. The orchestrator also opens a Cloudflare quick tunnel and logs control_url=.
# Set ATHENA_TUNNEL=off to keep the page on this machine only.
ATHENA_CONTROL_PORT=8787
ATHENA_TUNNEL=cloudflared
CONTROL_WEB_BASE_URL=http://127.0.0.1:3000
CONTROL_WEB_SIGNING_SECRET=change-me
ATHENA_WEBHOOK_BASE_URL=http://127.0.0.1:8080

# --- Backup: local + S3-compatible (MinIO locally; swap endpoint later) ---
# Relative path works on Mac and Windows. Override with D:/athena/backups on the box.
ATHENA_LOCAL_BACKUP_DIR=var/backups
ATHENA_S3_SYNC_ENABLED=true
ATHENA_S3_ENDPOINT=http://127.0.0.1:9000
ATHENA_S3_REGION=us-east-1
ATHENA_S3_BUCKET=athena-backups
ATHENA_S3_PREFIX=athena/windows-box/
ATHENA_S3_ACCESS_KEY_ID=minioadmin
ATHENA_S3_SECRET_ACCESS_KEY=minioadmin
ATHENA_S3_FORCE_PATH_STYLE=true
ATHENA_S3_TLS_VERIFY=true

# --- Optional DSH ---
DSH_BIN=
DSH_API_KEY=
